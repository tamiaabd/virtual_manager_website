{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve-localhost-8080",
      "type": "shell",
      "command": "python",
      "args": ["-m", "http.server", "8080"],
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "static-server",
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP on .* port 8080"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    }
  ]
}
